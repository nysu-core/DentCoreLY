# OrthoCore — Environment Configuration
#
# Copy the right example for your setup:
#   Local dev with SQLite:  cp .env.sqlite.example .env
#   Production PostgreSQL:  cp .env.postgresql.example .env
#
# DATABASE_PROVIDER: "sqlite" | "postgresql"
# STORAGE_PROVIDER:  "local"  | "imagekit"
# Both can be switched at any time — no code changes required.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
SERVER_BASE_URL=http://localhost:4000

# ImageKit (only needed when STORAGE_PROVIDER=imagekit)
# IMAGEKIT_PUBLIC_KEY=
# IMAGEKIT_PRIVATE_KEY=
# IMAGEKIT_URL_ENDPOINT=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ADMIN_EMAIL=Admin@dentcore.ly
ADMIN_PASSWORD=
