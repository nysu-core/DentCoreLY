# ════════════════════════════════════════════════════════════
# OrthoCore — PRODUCTION (PostgreSQL + Gmail or ImageKit)
# All services listed here have FREE tiers.
# ════════════════════════════════════════════════════════════

# ── FREE PostgreSQL options ─────────────────────────────────
#  • Self-hosted on any VPS/shared host (most common, free)
#  • Neon       → neon.tech        (free tier: 512 MB)
#  • Supabase   → supabase.com     (free tier: 500 MB)
#  • Railway    → railway.app      (free tier: 1 GB)
# ───────────────────────────────────────────────────────────

NODE_ENV=production
ADMIN_EMAIL=Admin@dentcore.ly
ADMIN_PASSWORD=
PORT=4000
CORS_ORIGIN=https://yourdomain.com
APP_URL=https://yourdomain.com
CLINIC_NAME=Orthodontics Department - Faculty of Dentistry - Benghazi

# ── Database ────────────────────────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://orthocore_user:strong_password@localhost:5432/orthocore?schema=public"
# Neon example:    DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
# Supabase example:DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres"

# ── Auth ────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File storage ────────────────────────────────────────────
# Option A: Local disk (FREE, works on any host with writable disk)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/var/www/orthocore/storage
SERVER_BASE_URL=https://yourdomain.com

# Option B: ImageKit (FREE tier — 20 GB storage + 20 GB bandwidth/month)
# Sign up free at https://imagekit.io → Dashboard → Developer options
# STORAGE_PROVIDER=imagekit
# IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxx
# IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ── Email via Gmail (FREE — requires only a Gmail account) ──
# Setup (one-time, 2 minutes):
#  1. Sign in to your Gmail account
#  2. Enable 2-Step Verification (myaccount.google.com/security)
#  3. Go to myaccount.google.com/apppasswords
#  4. Create app password → App: Mail, Device: OrthoCore → Copy the 16-char password
#  5. Paste it below (spaces in the password are fine)
# Free limits: 500 emails/day — more than enough for a clinic
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Research anonymisation salt ─────────────────────────────
# Must be a long random string. Keep it secret. Never change it
# after first use (changing it breaks existing anon_id consistency).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ANON_SALT=replace_with_long_random_string

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
