# ════════════════════════════════════════════════════════════
# OrthoCore — LOCAL DEVELOPMENT (SQLite + local storage)
# 100% free. No external services required.
# ════════════════════════════════════════════════════════════

# cp .env.sqlite.example .env
# npm install
# npm run prisma:push          ← creates dev.db (no migration files needed)
# npm run prisma:seed
# npm run prisma:seed:forms
# npm run dev

NODE_ENV=development
ADMIN_EMAIL=Admin@dentcore.ly
ADMIN_PASSWORD=
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
CLINIC_NAME=OrthoCore

# ── Database (SQLite — file in backend/) ───────────────────
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ── Auth ───────────────────────────────────────────────────
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=local_dev_change_me_please
JWT_REFRESH_SECRET=local_dev_change_me_too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── File storage (local disk — free, no account needed) ────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
SERVER_BASE_URL=http://localhost:4000

# ── Email ──────────────────────────────────────────────────
# Leave blank in local dev → emails are printed to the console
# instead of sent. You can see them in the terminal.
# To enable real sending, add Gmail App Password below.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Research anonymisation salt ────────────────────────────
ANON_SALT=local_dev_anon_salt_change_in_production

# ── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
